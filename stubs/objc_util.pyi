import ctypes
from collections.abc import Callable
from typing import Any, TypeVar

_F = TypeVar('_F', bound=Callable[..., Any])

def ObjCClass(name: str) -> Any: ...
def ns(obj: Any) -> Any: ...
def nsurl(path: str) -> Any: ...
def on_main_thread(func: _F) -> _F: ...
def ObjCInstance(obj: Any) -> Any: ...
def load_framework(name: str) -> None: ...
def ObjCBlock(func: Any, restype: Any = ..., argtypes: Any = ...) -> Any: ...
def sel(name: str) -> Any: ...
def create_objc_class(
    name: str,
    superclass: Any = ...,
    methods: list[Any] = ...,
    classmethods: list[Any] = ...,
    protocols: list[str] = ...,
) -> Any: ...

c: Any  # the C library (objc runtime functions) through ctypes

def nsdata_to_bytes(data: Any) -> bytes: ...

class NSRange(ctypes.Structure):
    def __init__(self, location: int = 0, length: int = 0) -> None: ...

def CGPoint(x: float, y: float) -> Any: ...
def CGSize(width: float, height: float) -> Any: ...
def CGRect(origin: Any, size: Any) -> Any: ...
