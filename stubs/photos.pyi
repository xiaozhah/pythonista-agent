from typing import Any

class Asset:
    creation_date: Any
    media_type: str
    def get_image_data(self, original: bool = ...) -> Any: ...
    def get_image(self, original: bool = ...) -> Any: ...

class AssetCollection:
    assets: list[Asset]

def pick_asset(assets: list[Asset] | None = ..., title: str = ..., multi: bool = ...) -> Asset | None: ...
def get_assets(media_type: str = ..., include_hidden: bool = ...) -> list[Asset]: ...
def get_screenshots_album() -> AssetCollection | None: ...
def capture_image() -> Any: ...
def create_image_asset(image_path: str) -> Asset: ...
